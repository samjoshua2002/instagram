# Copy to .env and fill in real values. Never commit .env.

# Server Configuration
PORT=3000
# production enforces webhook signatures (BYPASS_WEBHOOK_VERIFY is ignored)
NODE_ENV=production

# Public URLs
FRONTEND_URL=https://your-frontend.example.com
BACKEND_URL=https://your-backend.example.com
# Set automatically on Render; used to build public media links
RENDER_EXTERNAL_URL=

# MongoDB Connection
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Meta / Instagram App Configuration
META_APP_ID=
META_APP_SECRET=
META_APP_NAME=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Webhook Verify Token (required; any long random string, also entered in the Meta dashboard)
WEBHOOK_VERIFY_TOKEN=
# DEV ONLY: skip webhook signature checks. Ignored when NODE_ENV=production.
BYPASS_WEBHOOK_VERIFY=false

# Legacy admin Instagram account
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# GIPHY (optional platform default; each workspace can set its own key)
GIPHY_API_KEY=

# Optional Redis cache
REDIS_URL=

# Bot Settings
GLOBAL_BOT_ENABLED=true
TYPING_DELAY_MS=1500
CHAT_RETENTION_DAYS=30
# Number of reverse proxies in front of the app (for client IPs)
TRUST_PROXY_HOPS=1

# Authentication & Security
JWT_SECRET=
# 32-byte key (64 hex chars) used to encrypt stored tokens and API keys
ENCRYPTION_KEY=
OWNER_USERNAME=
OWNER_EMAIL=
OWNER_INITIAL_PASSWORD=
PASSKEY_RP_ID=your-frontend.example.com
PASSKEY_ORIGIN=https://your-frontend.example.com
RP_NAME="Chatter OS"

# Email
EMAIL_USER=
EMAIL_PASS=
BREVO_API_KEY=
RESEND_API_KEY=
RESEND_FROM=no-reply@your-domain.example.com
EMAIL_FROM_NAME=Chatter OS
